{
  "version": 2,
  "builds": [
    {
      "src": "Client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "Server/src/server.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/Server/src/server.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/Client/assets/$1"
    },
    {
      "src": "/(.*\\.(?:svg|png|jpg|jpeg|ico|json|txt))",
      "dest": "/Client/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/Client/index.html"
    }
  ]
}
